# Provider for the Cline SDK agent. Any built-in provider id works, e.g.
# anthropic | gemini | openrouter | openai-native | cline | deepseek
MODEL_PROVIDER=gemini
# Model used by the audit agent (tool calling + Kannada/Hindi writing).
# Tested: gemini-3.1-flash-lite (free tier, ~30 s per audit). gemini-3.5-flash also works
# but its free tier allows only ~20 requests/day (one audit uses ~6).
MODEL_ID=gemini-3.1-flash-lite
# Vision-capable model used to read screenshots. Same provider. Check with: npm run extract-demo
VISION_MODEL_ID=gemini-3.1-flash-lite
# API key for MODEL_PROVIDER. Never commit the real .env.
API_KEY=

# Server
PORT=8787
