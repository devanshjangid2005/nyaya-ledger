# Provider for the Cline SDK agent. Any built-in provider id works, e.g.
# anthropic | gemini | openrouter | openai-native | cline | deepseek
MODEL_PROVIDER=anthropic
# Model used by the audit agent (tool calling + Kannada/Hindi writing)
MODEL_ID=claude-sonnet-4-6
# Vision-capable model used to read screenshots (Phase 2). Same provider.
VISION_MODEL_ID=claude-sonnet-4-6
# API key for MODEL_PROVIDER. Never commit the real .env.
API_KEY=

# Server
PORT=8787
