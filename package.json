{
  "name": "nyaya-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a Karnataka gig worker's payout screenshots and bank SMS into a law-grounded grievance docket.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p . && tsc -p web",
    "demo": "tsx server/demo.ts",
    "smoke": "tsx scripts/smoke.ts",
    "screens": "tsx scripts/screens.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@cline/sdk": "^0.0.92",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
